<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:keepScreenOn="true">

    <!-- Primary Kiosk WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Right Connection Status Indicator -->
    <LinearLayout
        android:id="@+id/statusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#99111827"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#4CAF50" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Bulut (Online)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- QR Pairing Fullscreen Overlay -->
    <LinearLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0080A0F"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saraç TV Sipariş Ekranı"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Telefonunuzdaki SaraçApp uygulamasını açıp kamerayla bu QR kodu okutun."
            android:textColor="#9CA3AF"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="12dp">

            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtPairCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Oturum Kodu: ------"
            android:textColor="#F59E0B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSkipPairing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#374151"
            android:text="Eşleşmeyi Atla / Doğrudan Başlat"
            android:textColor="#E5E7EB"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
