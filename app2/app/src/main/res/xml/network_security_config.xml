<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration - SaracApp

  Policy:
  - Cloud traffic (bilalgnd.shop, HTTPS): TLS required, cleartext FORBIDDEN
  - Local LAN traffic (192.168.x.x, 10.x.x.x): cleartext ALLOWED for LAN POS hub

  To support more LAN IPs, add <domain> entries in the domain-config block below.
-->
<network-security-config>

  <!-- Base config: HTTPS enforced for all domains by default -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Local LAN ranges: cleartext allowed for POS hub connections only -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">192.168.1.1</domain>
    <domain includeSubdomains="false">192.168.0.1</domain>
    <domain includeSubdomains="false">192.168.1.100</domain>
    <domain includeSubdomains="false">192.168.1.101</domain>
    <domain includeSubdomains="false">192.168.1.102</domain>
    <domain includeSubdomains="false">192.168.1.103</domain>
    <domain includeSubdomains="false">192.168.1.104</domain>
    <domain includeSubdomains="false">192.168.1.105</domain>
    <domain includeSubdomains="false">10.0.0.1</domain>
    <domain includeSubdomains="false">10.0.0.2</domain>
    <domain includeSubdomains="false">172.16.0.1</domain>
  </domain-config>

</network-security-config>
